{
  "name": "dsh-market-sidebar",
  "version": "1.0.0",
  "private": true,
  "description": "Puts the dsh-market plugin market into the left sidebar footer, to the right of 远程控制.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",  "repository": {
    "type": "git",
    "url": "git+https://github.com/Palpitate1388/dsh-market-sidebar.git"
  },
  "homepage": "https://github.com/Palpitate1388/dsh-market-sidebar#readme",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "market", "sidebar"],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  }
}
